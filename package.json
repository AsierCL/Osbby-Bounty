{
	"name": "gentle-bounty",
	"version": "0.1.0",
	"private": true,
	"description": "Bug bounty control infrastructure for Pi: scope gate, rate limiting, hash-chained evidence, redaction, reports.",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": "^22.19.0 || >=23.6.0"
	},
	"scripts": {
		"test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
		"test:one": "node --experimental-strip-types --test",
		"test:live": "node --experimental-strip-types scripts/smoke-live.mjs",
		"engram:install": "bash engram/bin/install.sh",
		"engram:up": "bash engram/bin/engram-bounty up"
	},
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"files": [
		"assets/",
		"bin/",
		"config.example.json",
		"docs/",
		"engram/",
		"extensions/",
		"odd/",
		"scripts/",
		"src/",
		"scope.template.yaml"
	]
}
